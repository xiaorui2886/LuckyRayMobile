{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luckyray.local/companion/services-v1/2026-09-30.1/schema.json",
  "$defs": {
    "Identifier": {"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9_-]+$"},
    "Revision": {"type":"string","minLength":1,"maxLength":160},
    "Sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "GrantClass": {"enum":["content.read","content.write","ingest.write","desktop.open","lsh.remote"]},
    "OperationState": {"enum":["implemented","notGranted","temporarilyUnavailable","unsupported"]},
    "OperationStatus": {"type":"object","required":["state","capability","grant","scope"],"properties":{"state":{"$ref":"#/$defs/OperationState"},"capability":{"type":"string","minLength":1},"grant":{"anyOf":[{"$ref":"#/$defs/GrantClass"},{"type":"null"}]},"scope":{"enum":["pairedDevice","device","catalog","asset","currentVault","currentVaultNote","registeredVaults","registeredVault","registeredVaultNote","targetCatalogOrVault","ownedJob","visibleCatalogAndVaults","typedAssetOrVaultNote"]}},"additionalProperties":false},
    "ServiceSummary": {"type":"object","required":["version","available","granted"],"properties":{"version":{"type":"integer","minimum":1},"available":{"type":"boolean"},"granted":{"type":"boolean"}},"additionalProperties":false},
    "Limits": {"type":"object","required":["pageSize","batchItems","noteBytes","uploadBytes","uploadChunkBytes","concurrentUploads","searchResults"],"properties":{"pageSize":{"type":"integer","minimum":1,"maximum":100},"batchItems":{"type":"integer","minimum":1,"maximum":100},"noteBytes":{"type":"integer","minimum":1,"maximum":4194304},"uploadBytes":{"type":"integer","minimum":1,"maximum":67108864},"uploadChunkBytes":{"type":"integer","minimum":1,"maximum":262144},"concurrentUploads":{"type":"integer","minimum":1,"maximum":4},"searchResults":{"type":"integer","minimum":1,"maximum":50}},"additionalProperties":false},
    "ServiceCatalog": {"type":"object","required":["catalogVersion","bundleRevision","desktopInstanceId","gatewayGeneration","permissionRevision","services","operations","limits"],"properties":{"catalogVersion":{"const":1},"bundleRevision":{"type":"string","minLength":1},"desktopInstanceId":{"$ref":"#/$defs/Identifier"},"gatewayGeneration":{"type":"integer","minimum":0},"permissionRevision":{"type":"integer","minimum":0},"services":{"type":"object","required":["materials","knowledge","ingest","search","changes","presentation","lsh"],"properties":{"materials":{"$ref":"#/$defs/ServiceSummary"},"knowledge":{"$ref":"#/$defs/ServiceSummary"},"ingest":{"$ref":"#/$defs/ServiceSummary"},"search":{"$ref":"#/$defs/ServiceSummary"},"changes":{"$ref":"#/$defs/ServiceSummary"},"presentation":{"$ref":"#/$defs/ServiceSummary"},"lsh":{"$ref":"#/$defs/ServiceSummary"}},"additionalProperties":false},"operations":{"type":"object","additionalProperties":{"$ref":"#/$defs/OperationStatus"}},"limits":{"$ref":"#/$defs/Limits"}},"additionalProperties":false},
    "SafeSource": {"type":"object","required":["captureKind"],"properties":{"captureKind":{"enum":["web","import","clipboard","unknown"]},"pageKind":{"enum":["work-page","capture-page"]},"pageUrl":{"type":"string","format":"safe-web-url","maxLength":2048,"pattern":"^https?://"},"siteOrigin":{"type":"string","format":"safe-web-url","maxLength":512,"pattern":"^https?://"},"capturedAt":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"pageKind":{"const":"work-page"}},"required":["pageKind"]},"then":{"required":["pageUrl"]}}],"additionalProperties":false,"$comment":"safe-web-url follows the existing #169 source validator: no userinfo, direct media path, sensitive query key or sensitive decoded fragment key; ordinary query/SPA fragments are retained. siteOrigin must equal URL.origin. Missing pageKind is capture-page on ingest; work-page requires pageUrl. See routes.md."},
    "MaterialDetail": {"type":"object","required":["assetId","name","kind","mimeType","sizeBytes","revision"],"properties":{"assetId":{"$ref":"#/$defs/Identifier"},"name":{"type":"string","minLength":1,"maxLength":255},"kind":{"type":"string"},"mimeType":{"type":"string"},"sizeBytes":{"type":"integer","minimum":0},"revision":{"$ref":"#/$defs/Revision"},"description":{"type":["string","null"],"maxLength":4096},"source":{"$ref":"#/$defs/SafeSource"}},"additionalProperties":false},
    "MaterialPatch": {"type":"object","required":["opId","expectedRevision"],"anyOf":[{"required":["name"]},{"required":["description"]}],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"expectedRevision":{"$ref":"#/$defs/Revision"},"name":{"type":"string","minLength":1,"maxLength":255},"description":{"type":["string","null"],"maxLength":4096}},"additionalProperties":false},
    "MaterialRemove": {"type":"object","required":["opId","expectedRevision","mode"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"expectedRevision":{"$ref":"#/$defs/Revision"},"mode":{"const":"removeRecord"}},"additionalProperties":false},
    "MaterialReceipt": {"type":"object","required":["opId","assetId","revision","disposition"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"assetId":{"$ref":"#/$defs/Identifier"},"revision":{"$ref":"#/$defs/Revision"},"disposition":{"enum":["updated","removed"]}},"additionalProperties":false},
    "MaterialChange": {"type":"object","required":["cursor","assetId","revision","kind","tombstone"],"properties":{"cursor":{"type":"string","minLength":1},"assetId":{"$ref":"#/$defs/Identifier"},"revision":{"$ref":"#/$defs/Revision"},"kind":{"enum":["created","updated","moved","tagged","favorited","removed"]},"tombstone":{"type":"boolean"}},"additionalProperties":false},
    "MaterialChangePage": {"type":"object","required":["items","snapshotCursor","nextCursor","hasMore"],"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/MaterialChange"}},"snapshotCursor":{"type":"string","minLength":1},"nextCursor":{"type":"string","minLength":1},"hasMore":{"type":"boolean"}},"additionalProperties":false},
    "VaultDescriptor": {"type":"object","required":["vaultId","displayName","activeInDesktop","readGranted","writeGranted","revision"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"displayName":{"type":"string","minLength":1,"maxLength":255},"activeInDesktop":{"type":"boolean"},"readGranted":{"type":"boolean"},"writeGranted":{"type":"boolean"},"revision":{"$ref":"#/$defs/Revision"}},"additionalProperties":false},
    "VaultPage": {"type":"object","required":["items"],"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/VaultDescriptor"}}},"additionalProperties":false},
    "KnowledgeNoteSummary": {"type":"object","required":["vaultId","noteId","title","revision","parentRelativePath"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"title":{"type":"string","maxLength":255},"revision":{"$ref":"#/$defs/Revision"},"parentRelativePath":{"type":"string","maxLength":1024}},"additionalProperties":false},
    "KnowledgeNotePage": {"type":"object","required":["items","hasMore","nextAfterId"],"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/KnowledgeNoteSummary"}},"hasMore":{"type":"boolean"},"nextAfterId":{"type":["string","null"]}},"additionalProperties":false},
    "KnowledgeMove": {"type":"object","required":["opId","vaultId","expectedRevision","parentRelativePath"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"vaultId":{"$ref":"#/$defs/Identifier"},"expectedRevision":{"$ref":"#/$defs/Revision"},"parentRelativePath":{"type":"string","maxLength":1024,"pattern":"^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]*$"}},"additionalProperties":false},
    "KnowledgeMoveReceipt": {"type":"object","required":["opId","vaultId","noteId","revision","parentRelativePath"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"revision":{"$ref":"#/$defs/Revision"},"parentRelativePath":{"type":"string","maxLength":1024}},"additionalProperties":false},
    "KnowledgeChange": {"type":"object","required":["cursor","vaultId","noteId","revision","deleted"],"properties":{"cursor":{"type":"string","minLength":1},"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"revision":{"$ref":"#/$defs/Revision"},"deleted":{"type":"boolean"}},"additionalProperties":false},
    "KnowledgeChangePage": {"type":"object","required":["items","snapshotCursor","nextCursor","hasMore"],"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/KnowledgeChange"}},"snapshotCursor":{"type":"string","minLength":1},"nextCursor":{"type":"string","minLength":1},"hasMore":{"type":"boolean"}},"additionalProperties":false},
    "IngestTarget": {"oneOf":[{"type":"object","required":["domain"],"properties":{"domain":{"const":"materials"},"folderId":{"anyOf":[{"$ref":"#/$defs/Identifier"},{"type":"null"}]}},"additionalProperties":false},{"type":"object","required":["domain","vaultId","parentRelativePath"],"properties":{"domain":{"const":"knowledge"},"vaultId":{"$ref":"#/$defs/Identifier"},"parentRelativePath":{"type":"string","maxLength":1024,"pattern":"^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]*$"}},"additionalProperties":false}]},
    "IngestBegin": {"type":"object","required":["opId","kind","target","name","mimeType","sizeBytes","sha256"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"kind":{"enum":["text","url","image","video","file","clipboard"]},"target":{"$ref":"#/$defs/IngestTarget"},"name":{"type":"string","minLength":1,"maxLength":255},"mimeType":{"type":"string","minLength":1,"maxLength":255},"sizeBytes":{"type":"integer","minimum":1,"maximum":67108864},"sha256":{"$ref":"#/$defs/Sha256"},"text":{"type":"string","minLength":1,"maxLength":4194304},"source":{"$ref":"#/$defs/SafeSource"}},"allOf":[{"if":{"properties":{"kind":{"enum":["text","url","clipboard"]}},"required":["kind"]},"then":{"required":["text"]},"else":{"not":{"required":["text"]}}}],"additionalProperties":false,"$comment":"For inline kinds sizeBytes and sha256 must equal the UTF-8 bytes of text; url text must pass safe-web-url. These semantic checks are mandatory."},
    "IngestReceipt": {"type":"object","required":["domain","revision"],"properties":{"domain":{"enum":["materials","knowledge"]},"assetId":{"$ref":"#/$defs/Identifier"},"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"revision":{"$ref":"#/$defs/Revision"}},"additionalProperties":false},
    "IngestJob": {"type":"object","required":["jobId","opId","state","committedBytes"],"properties":{"jobId":{"$ref":"#/$defs/Identifier"},"opId":{"$ref":"#/$defs/Identifier"},"state":{"enum":["staging","completed","cancelled"]},"committedBytes":{"type":"integer","minimum":0},"receipt":{"$ref":"#/$defs/IngestReceipt"}},"additionalProperties":false},
    "ResourceDescriptor": {"type":"object","required":["domain","resourceId","version","mimeType","length"],"properties":{"domain":{"enum":["materials","knowledge"]},"resourceId":{"$ref":"#/$defs/Identifier"},"version":{"$ref":"#/$defs/Revision"},"mimeType":{"type":"string"},"length":{"type":"integer","minimum":0}},"additionalProperties":false},
    "SearchHit": {"oneOf":[{"type":"object","required":["domain","assetId","title"],"properties":{"domain":{"const":"materials"},"assetId":{"$ref":"#/$defs/Identifier"},"title":{"type":"string"},"subtitle":{"type":"string"},"resource":{"$ref":"#/$defs/ResourceDescriptor"}},"additionalProperties":false},{"type":"object","required":["domain","vaultId","noteId","title"],"properties":{"domain":{"const":"knowledge"},"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"title":{"type":"string"},"path":{"type":"string"},"snippet":{"type":"string"}},"additionalProperties":false}]},
    "SearchPage": {"type":"object","required":["items"],"properties":{"items":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/SearchHit"}},"nextCursor":{"type":["string","null"]}},"additionalProperties":false},
    "PresentationTarget": {"oneOf":[{"type":"object","required":["domain","assetId"],"properties":{"domain":{"const":"materials"},"assetId":{"$ref":"#/$defs/Identifier"}},"additionalProperties":false},{"type":"object","required":["domain","vaultId","noteId"],"properties":{"domain":{"const":"knowledge"},"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"}},"additionalProperties":false}]},
    "PresentationOpen": {"type":"object","required":["opId","target"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"target":{"$ref":"#/$defs/PresentationTarget"}},"additionalProperties":false},
    "PresentationReceipt": {"type":"object","required":["opId","state"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"state":{"enum":["accepted","handoffStarted","queued","displayed","refused"]},"reason":{"enum":["busy","dirtyDraft","targetUnavailable"]}},"additionalProperties":false},
    "EventHint": {"oneOf":[{"type":"object","required":["kind","permissionRevision"],"properties":{"kind":{"const":"servicesChanged"},"permissionRevision":{"type":"integer","minimum":0}},"additionalProperties":false},{"type":"object","required":["kind","cursor"],"properties":{"kind":{"const":"materialChanged"},"cursor":{"type":"string"}},"additionalProperties":false},{"type":"object","required":["kind","vaultId","cursor"],"properties":{"kind":{"const":"knowledgeChanged"},"vaultId":{"$ref":"#/$defs/Identifier"},"cursor":{"type":"string"}},"additionalProperties":false},{"type":"object","required":["kind","jobId"],"properties":{"kind":{"const":"ingestChanged"},"jobId":{"$ref":"#/$defs/Identifier"}},"additionalProperties":false},{"type":"object","required":["kind"],"properties":{"kind":{"const":"lshStateChanged"}},"additionalProperties":false}]},
    "KnowledgeUniqueCreate": {"allOf":[{"$ref":"https://luckyray.invalid/companion/content-v1/schema.json#/$defs/Mutation"},{"properties":{"kind":{"const":"create"},"expectedRevision":{"enum":["",null]}}}],"$comment":"Exact existing Content Mutation fields. Domain title/path/content validation and 4MiB UTF-8 note bound remain mandatory; do not normalize a prepared payload."},
    "KnowledgeUniqueReceipt": {"type":"object","required":["opId","document"],"properties":{"opId":{"$ref":"#/$defs/Identifier"},"document":{"$ref":"https://luckyray.invalid/companion/content-v1/schema.json#/$defs/Note"}},"additionalProperties":false},
    "KnowledgeEditingStatus": {"type":"object","required":["vaultId","noteId","desktopEditing","mobileEditing","leaseMs"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"desktopEditing":{"type":"boolean"},"mobileEditing":{"type":"boolean"},"leaseMs":{"const":15000}},"additionalProperties":false},
    "KnowledgeEditingOpen": {"type":"object","required":["vaultId"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"}},"additionalProperties":false},
    "KnowledgeEditingSet": {"type":"object","required":["vaultId","sessionId","generation","editing"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"sessionId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"generation":{"type":"integer","minimum":1,"maximum":9007199254740991},"editing":{"type":"boolean"}},"additionalProperties":false},
    "KnowledgeEditingLease": {"type":"object","required":["vaultId","noteId","sessionId","generation","editing","leaseMs"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"sessionId":{"type":"string","pattern":"^[a-f0-9]{32}$"},"generation":{"type":"integer","minimum":0,"maximum":9007199254740991},"editing":{"type":"boolean"},"leaseMs":{"const":15000}},"additionalProperties":false,"$comment":"POST yields generation0/editingfalse inert15s token; PUT only changes an existing live token. A removed token is410 even for a higher generation."},
    "KnowledgeDirectoryPage": {"type":"object","required":["vaultId","items","nextAfterPath","hasMore"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"items":{"type":"array","maxItems":100,"items":{"type":"object","required":["parentRelativePath"],"properties":{"parentRelativePath":{"type":"string","maxLength":1024}},"additionalProperties":false}},"nextAfterPath":{"type":["string","null"],"maxLength":1024},"hasMore":{"type":"boolean"}},"additionalProperties":false,"$comment":"Safe existing relative physical paths only, <=1024 UTF-8 bytes, root empty string first; live lexical cursor, not a durable cursor."},
    "KnowledgeRelation": {"oneOf":[{"type":"object","required":["kind","target","line","status","noteIds"],"properties":{"kind":{"const":"wikiLink"},"target":{"type":"string","minLength":1,"maxLength":1024},"line":{"type":"integer","minimum":1},"status":{"enum":["resolved","ambiguous","unresolved"]},"noteIds":{"type":"array","items":{"$ref":"#/$defs/Identifier"}}},"additionalProperties":false},{"type":"object","required":["kind","sourceNoteId","target","line","status","noteIds"],"properties":{"kind":{"const":"backlink"},"sourceNoteId":{"$ref":"#/$defs/Identifier"},"target":{"type":"string","minLength":1,"maxLength":1024},"line":{"type":"integer","minimum":1},"status":{"enum":["resolved","ambiguous","unresolved"]},"noteIds":{"type":"array","items":{"$ref":"#/$defs/Identifier"}}},"additionalProperties":false},{"type":"object","required":["kind","assetId","target"],"properties":{"kind":{"const":"material"},"assetId":{"$ref":"#/$defs/Identifier"},"target":{"type":"string","minLength":1,"maxLength":1024}},"additionalProperties":false}]},
    "KnowledgeRelationPage": {"type":"object","required":["vaultId","noteId","revision","items","nextAfter","hasMore"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"noteId":{"$ref":"#/$defs/Identifier"},"revision":{"$ref":"#/$defs/Revision"},"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/KnowledgeRelation"}},"nextAfter":{"type":["string","null"]},"hasMore":{"type":"boolean"}},"additionalProperties":false},
    "KnowledgeMaterialReferencePage": {"type":"object","required":["vaultId","assetId","items","nextAfter","hasMore"],"properties":{"vaultId":{"$ref":"#/$defs/Identifier"},"assetId":{"$ref":"#/$defs/Identifier"},"items":{"type":"array","maxItems":100,"items":{"type":"object","required":["noteId","target"],"properties":{"noteId":{"$ref":"#/$defs/Identifier"},"target":{"type":"string","minLength":1,"maxLength":1024}},"additionalProperties":false}},"nextAfter":{"type":["string","null"]},"hasMore":{"type":"boolean"}},"additionalProperties":false,"$comment":"Requires content.read/catalog AND content.read/currentVault. Bindings intersect current actual Markdown attachment links, never guessed filenames."},
    "ServiceError": {"type":"object","required":["code"],"properties":{"code":{"type":"string","minLength":1,"maxLength":64}},"additionalProperties":false}
  }
}
